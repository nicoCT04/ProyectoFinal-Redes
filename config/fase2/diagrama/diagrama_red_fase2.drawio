"/></mxCell><mxCell id="c12" value="&lt;b&gt;vm-ti-01&lt;/b&gt;&lt;br&gt;10.10.0.100&lt;br&gt;jump host SSH" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;imageWidth=30;imageHeight=30;fillColor=#dbe8f6;fontStyle=0;strokeColor=#2f74d0;strokeWidth=1.5;align=left;spacingLeft=44;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="200" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Data Center · snet-datacenter&lt;/b&gt; · 10.10.0.128/28" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#8aa9cf;" vertex="1" parent="1"><mxGeometry x="610" y="320" width="480" height="300" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;vm-dns&lt;/b&gt; · 10.10.0.132&lt;br&gt;BIND9 · farmaruta.local&lt;br&gt;ufw: 53 udp/tcp, 22 (TI)" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;imageWidth=30;imageHeight=30;fillColor=#dbe8f6;fontStyle=0;strokeColor=#2f74d0;strokeWidth=1.5;align=left;spacingLeft=44;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="370" width="210" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;vm-intranet&lt;/b&gt; · 10.10.0.133&lt;br&gt;nginx · rrhh.farmaruta.local&lt;br&gt;sin IP pública · ufw: 80, 22 (TI)" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;imageWidth=30;imageHeight=30;fillColor=#dbe8f6;fontStyle=0;strokeColor=#2f74d0;strokeWidth=1.5;align=left;spacingLeft=44;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="490" width="210" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;nsg-datacenter&lt;/b&gt; (entrada)&lt;br&gt;100 Allow-TI&lt;br&gt;110 Allow-Propia-Subred&lt;br&gt;120 Allow-DNS-Interno&lt;b
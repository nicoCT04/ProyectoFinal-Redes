tX=0.5;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="c25" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="1008"/><mxPoint x="798" y="1008"/></Array></mxGeometry></mxCell><mxCell id="c38" value="Deny-DMZ-&lt;br&gt;hacia-Internas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d23b2f;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=cross;endFill=0;endSize=10;fontColor=#b3261e;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=none;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="34" as="offset"/></mxGeometry></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9c9c2;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1640" height="135" as="geometry"/></mxCell><mxCell id="c40" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="1072" width="10" height="10" as="geometry"/></mxCell><mxCell id="c41" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="1072" width="10" height="10" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e9e3e;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1e7a33;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="Tráfico permitido (NSG y ufw lo dejan pasar)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="1064" width="380" height="26" as="geometry"/></mxCell><mxCell id="c44" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="1108" width="10" height="10" as="geometry"/></mxCell><mxCell id="c45" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="1108" width="10" height="10" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d23b2f;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=cross;endFill=0;endSize=10;fontColor=#b3261e;labelBackgroundColor=#ffffff;fontSize=11;edgeStyle=none;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="Tráfico bloqueado (timeout: el NSG descarta el paquete)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="1100" width="380" height="26" as="geometry"/></mxCell><mxCell id="c48" value="NSG stateful: la respuesta de una conexión permitida regresa sola (TI llega a todas, nadie llega a TI)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1140" width="500" height="30" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Defensa en profundidad&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;NSG por subred&lt;/b&gt; (firewall de Azure): filtra antes de que el paquete llegue a la VM.&lt;br&gt;2. &lt;b&gt;ufw en cada VM&lt;/b&gt;: default deny incoming, solo los puertos del rol y solo desde las subredes que los usan.&lt;br&gt;3. &lt;b&gt;SSH endurecido&lt;/b&gt;: solo llave, sin root, solo azureuser, MaxAuthTries 3, sin reenvío salvo el jump host.&lt;br&gt;4. &lt;b&gt;Servicios&lt;/b&gt;: BIND9 con ACL y sin recursión abierta; nginx de la intranet con allow/deny por subred y escucha solo en 10.10.0.133." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="1060" width="1060" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>